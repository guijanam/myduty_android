<?xml version="1.0" encoding="utf-8"?>
<!--
  Wear OS 스플래시 화면 아이콘 (Google Play 품질 가이드라인 대응).
  windowSplashScreenAnimatedIcon 슬롯에 표시되는 드로어블.

  ★ 실제 앱 로고("내근무" 캐릭터)를 사용한다.
  ★ 원형 마스크 대응: splash_logo.png 는 실제 로고 둘레에 투명 여백을
     넣어 정사각형 일러스트가 원 안에 내접하도록 만든 이미지다.
     (windowSplashScreen 은 layer-list inset 을 무시하고 아이콘을 고정
      크기로 스케일하므로, 여백을 이미지 자체에 포함시켜야 한다.)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_logo" />
</layer-list>
